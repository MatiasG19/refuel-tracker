{
  "name": "refuel-tracker",
  "version": "0.0.1",
  "description": "Tracks your refuels.",
  "productName": "Refuel Tracker",
  "author": "MatiasG19",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "check-format": "prettier --check ./src",
    "write-format": "prettier --write ./src",
    "test": "vitest run",
    "dev": "quasar dev",
    "conf": "quasar clean --conf",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "mode": "quasar mode add capacitor",
    "appdev": "quasar dev -m capacitor -T android",
    "appbuild": "quasar build -m capacitor -T android -- bundleRelease",
    "favicons": "icongenie generate --theme-color 8488ff --icon ./.icons/icon.png",
    "appicons": "icongenie generate --mode capacitor --theme-color 8488ff --skip-trim --icon ./.icons/appicon.png",
    "splashicons": "icongenie generate --mode capacitor --filter splashscreen --splashscreen-icon-ratio 30 --theme-color 8488ff --skip-trim --icon ./.icons/icon.png"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "@vueuse/core": "^14.4.0",
    "dexie": "^3.2.7",
    "dexie-export-import": "^4.1.4",
    "pinia": "^3.0.4",
    "quasar": "^2.32.2",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vue3-smooth-dnd": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@quasar/app-vite": "^2.6.2",
    "@types/node": "^26.4.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@rollup/rollup-linux-x64-gnu": "^4.63.2",
    "sass-embedded-linux-x64": "^1.104.1"
  },
  "engines": {
    "node": "^24",
    "npm": ">= 11"
  }
}
